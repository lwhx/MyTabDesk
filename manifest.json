{
  "manifest_version": 3,
  "name": "MyTabDesk",
  "version": "2.1.0",
  "description": "A local-first tab workspace for saving, organizing, and restoring browser tabs.",
  "permissions": [
    "tabs",
    "tabGroups",
    "bookmarks",
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "favicon",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "action": {
    "default_title": "MyTabDesk",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "commands": {
    "open-mytabdesk": {
      "suggested_key": { "default": "Alt+Shift+D", "mac": "Alt+Shift+D" },
      "description": "打开 MyTabDesk"
    },
    "save-current-tab": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "保存当前标签到 MyTabDesk"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
